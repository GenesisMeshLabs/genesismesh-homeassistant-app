{
  "name": "genesismesh-homeassistant-app",
  "version": "0.1.0-dev.0",
  "private": true,
  "type": "module",
  "description": "Governed Home Assistant requests for people, agents, machines and devices",
  "engines": {
    "node": ">=24.14.0 <25"
  },
  "scripts": {
