    "test:integration": "npm run build && node scripts/integration.mjs",
    "start": "node dist/src/main.js"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "fastify": "5.12.7",
    "genesis-mesh-sdk": "1.8.1"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "7.0.2"
  }
}
